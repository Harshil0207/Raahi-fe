# Backend API root. Must include /api/v1.
VITE_API_URL=http://localhost:5000/api/v1

# Socket.IO server root (no path suffix).
VITE_SOCKET_URL=http://localhost:5000

# Map tiles. The default is OpenStreetMap's public tile server, which is fine for
# development but asks that you not send production traffic to it — swap in your
# own tile host or a provider URL when you deploy.
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors

# The public origin the customer app is served from, used for canonical URLs,
# og:url, structured data and sitemap.xml. Leave it unset in development: with
# no value, those are omitted entirely rather than pointing at the wrong host,
# and robots.txt is still written.
VITE_PUBLIC_SITE_URL=

